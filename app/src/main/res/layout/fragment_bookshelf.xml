<?xml version="1.0" encoding="utf-8"?>
<!-- 书架页：统计概览 + 继续朗读 + 视图/排序切换 + 收藏列表 + 空态 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <!-- 标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="@dimen/space_4"
        android:paddingEnd="@dimen/page_margin">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/shelf_title"
            android:textAppearance="@style/TextAppearance.Poetry.PageTitle" />

        <TextView
            android:id="@+id/shelfSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:text="@string/shelf_subtitle"
            android:textAppearance="@style/TextAppearance.Poetry.Caption" />
    </LinearLayout>

    <!-- 统计卡 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_margin"
        android:layout_marginTop="@dimen/space_4"
        android:layout_marginEnd="@dimen/page_margin"
        android:background="@drawable/bg_shelf_stat_gradient"
        android:orientation="horizontal"
        android:padding="@dimen/space_4">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/statFav"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textAppearance="@style/TextAppearance.Poetry.StatValue"
                android:textColor="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="@string/shelf_stat_fav"
                android:textAppearance="@style/TextAppearance.Poetry.Caption"
                android:textColor="@color/white" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/statType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textAppearance="@style/TextAppearance.Poetry.StatValue"
                android:textColor="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="@string/shelf_stat_type"
                android:textAppearance="@style/TextAppearance.Poetry.Caption"
                android:textColor="@color/white" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/statHours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textAppearance="@style/TextAppearance.Poetry.StatValue"
                android:textColor="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="@string/shelf_stat_hours"
                android:textAppearance="@style/TextAppearance.Poetry.Caption"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>

    <!-- 继续朗读 -->
    <LinearLayout
        android:id="@+id/resumeCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_margin"
        android:layout_marginTop="@dimen/space_3"
        android:layout_marginEnd="@dimen/page_margin"
        android:background="@drawable/bg_card_lg"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_4">

        <TextView
            android:id="@+id/resumeIcon"
            android:layout_width="@dimen/size_badge_icon"
            android:layout_height="@dimen/size_badge_icon"
            android:background="@drawable/bg_resume_icon"
            android:gravity="center"
            android:text="▶"
            android:textColor="@color/white"
            android:textSize="@dimen/text_lg" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_3"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/resumeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Poetry.CardTitle" />

            <TextView
                android:id="@+id/resumeSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Poetry.Caption" />
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/ink_400" />
    </LinearLayout>


    <!-- 书架内搜索 -->
    <EditText
        android:id="@+id/shelfSearch"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_search_height"
        android:layout_marginStart="@dimen/page_margin"
        android:layout_marginTop="@dimen/space_3"
        android:layout_marginEnd="@dimen/page_margin"
        android:background="@drawable/bg_search_field"
        android:hint="@string/shelf_search_hint"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="@dimen/space_3"
        android:paddingEnd="@dimen/space_3"
        android:textAppearance="@style/TextAppearance.Poetry.Body" />

    <!-- 排序 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_margin"
        android:layout_marginTop="@dimen/space_4"
        android:layout_marginEnd="@dimen/page_margin"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/sortChips"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:chipSpacingHorizontal="@dimen/space_1"
            app:singleLine="true" />
    </LinearLayout>

    <!-- 视图切换在左，删除 / 清空在右：两组分开一行，不再挤在一起 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_margin"
        android:layout_marginTop="@dimen/space_2"
        android:layout_marginEnd="@dimen/page_margin"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnGrid"
            style="@style/Widget.Poetry.SegmentButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/shelf_view_grid" />

        <Button
            android:id="@+id/btnList"
            style="@style/Widget.Poetry.SegmentButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_1"
            android:minWidth="0dp"
            android:text="@string/shelf_view_list" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnDone"
            style="@style/Widget.Poetry.SegmentButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/shelf_edit_done" />

        <Button
            android:id="@+id/btnClear"
            style="@style/Widget.Poetry.SegmentButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_1"
            android:minWidth="0dp"
            android:text="@string/shelf_clear" />
    </LinearLayout>

    <!-- 收藏列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/shelfList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_3"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/page_margin"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="@dimen/space_4" />

    <!-- 空态 -->
    <include
        android:id="@+id/emptyState"
        layout="@layout/view_empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <TextView
        android:id="@+id/shelfFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="@dimen/space_4"
        android:text="@string/shelf_footer"
        android:textAppearance="@style/TextAppearance.Poetry.CaptionWeak" />

</LinearLayout>
