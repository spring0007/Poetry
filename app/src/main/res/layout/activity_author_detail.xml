<?xml version="1.0" encoding="utf-8"?>
<!--
  作者详情：顶部标题栏（作者名）+ 头像 / 姓名 / 朝代 / 作品数 + 简介 + 代表作品
  导航与返回行为与作品详情页保持一致（MaterialToolbar + 返回键）。
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- 顶部标题栏 -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:liftOnScroll="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationContentDescription="@string/cd_back"
            app:navigationIcon="@drawable/ic_back"
            app:titleCentered="true" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/authorScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="@dimen/space_4"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="@dimen/space_10"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 头像 -->
            <TextView
                android:id="@+id/authorAvatar"
                android:layout_width="@dimen/size_profile_avatar"
                android:layout_height="@dimen/size_profile_avatar"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_profile_avatar"
                android:fontFamily="serif"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/white"
                android:textSize="@dimen/text_hero" />

            <!-- 姓名 -->
            <TextView
                android:id="@+id/authorName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_3"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textAppearance="@style/TextAppearance.Poetry.PageTitle" />

            <!-- 朝代 · 存世作品 -->
            <TextView
                android:id="@+id/authorMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_1"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Poetry.Caption" />

            <!-- 两项统计 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_md"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4">

                    <TextView
                        android:id="@+id/statDynastyValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Poetry.StatValue" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:text="@string/author_stat_dynasty"
                        android:textAppearance="@style/TextAppearance.Poetry.CaptionWeak" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_3"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_md"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4">

                    <TextView
                        android:id="@+id/statPoemsValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Poetry.StatValue" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:text="@string/author_stat_poems"
                        android:textAppearance="@style/TextAppearance.Poetry.CaptionWeak" />
                </LinearLayout>
            </LinearLayout>

            <!-- 作者简介 -->
            <TextView
                android:id="@+id/introTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:text="@string/author_detail_title"
                android:textAppearance="@style/TextAppearance.Poetry.SectionTitle" />

            <TextView
                android:id="@+id/authorIntro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:lineSpacingExtra="@dimen/line_spacing_body"
                android:textAppearance="@style/TextAppearance.Poetry.Body" />

            <!-- 代表作品 -->
            <include
                android:id="@+id/worksHeader"
                layout="@layout/view_section_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/worksList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <ProgressBar
                android:id="@+id/loadingBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_8"
                android:visibility="gone" />

            <include
                android:id="@+id/emptyState"
                layout="@layout/view_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
