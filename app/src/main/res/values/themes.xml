<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 日间主题：宣纸暖白底 + 暖调墨色文字 -->
    <style name="Theme.Poetry" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/color_accent</item>
        <item name="colorOnSecondary">@color/on_primary</item>
        <item name="colorSurface">@color/surface_1</item>
        <item name="colorOnSurface">@color/ink_900</item>
        <item name="colorSurfaceVariant">@color/surface_2</item>
        <item name="colorOnSurfaceVariant">@color/ink_500</item>
        <item name="colorOutline">@color/line</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:textColorPrimary">@color/ink_900</item>
        <item name="android:textColorSecondary">@color/ink_500</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/paper</item>
    </style>

    <!-- ================= 皮肤 =================
         每套只重定义「纸底 / 卡片 / 主色 / 强调 / 描边」这几项，文字墨色沿用。
         夜间不需要再写一遍：同名颜色在 values-night/colors.xml 里另有定义，
         父主题 Theme.Poetry 在夜间也会解析到 values-night 版本。 -->

    <!-- 宣纸（默认）：暖白纸 + 朱红 -->
    <style name="Theme.Poetry.Xuan" parent="Theme.Poetry">
        <item name="colorPrimary">@color/skin_xuan_primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/skin_xuan_accent</item>
        <item name="colorOnSecondary">@color/on_primary</item>
        <item name="colorSurface">@color/skin_xuan_surface</item>
        <item name="colorSurfaceVariant">@color/skin_xuan_surface_2</item>
        <item name="colorOutline">@color/skin_xuan_line</item>
        <item name="android:colorBackground">@color/skin_xuan_paper</item>
        <item name="android:windowBackground">@color/skin_xuan_paper</item>
        <item name="android:statusBarColor">@color/skin_xuan_paper</item>
        <item name="android:navigationBarColor">@color/skin_xuan_paper</item>
    </style>

    <!-- 青瓷：青白纸 + 石青 -->
    <style name="Theme.Poetry.Qingci" parent="Theme.Poetry">
