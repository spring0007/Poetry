<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 访问内容接口、下载诗库、播放服务端合成的音频 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        读当前网络状态：判断「是不是不计流量的网络」。
        普通权限，不弹框。缺了不会崩——DbDownloadPolicy 里 try/catch 之后按「可以下」处理，
        代价是自动模式会静默地在移动网络上下载。
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".PoetryApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Poetry">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Poetry"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DetailActivity"
            android:exported="false"
            android:label="@string/tab_discover"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.Poetry"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".PoemListActivity"
            android:exported="false"
            android:label="@string/category_title"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.Poetry"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".VoiceSettingsActivity"
            android:exported="false"
            android:label="@string/tts_settings_title"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.Poetry"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SkinActivity"
            android:exported="false"
            android:label="@string/skin_title"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.Poetry"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:label="@string/about_title"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.Poetry"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:label="@string/history_title"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.Poetry"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".StatsActivity"
            android:exported="false"
            android:label="@string/stats_title"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.Poetry"
            android:windowSoftInputMode="adjustResize" />

        <!-- 微信开放平台 AppID：填入真实值后，登录页自动从「模拟登录」切换为真实授权 -->
        <meta-data
            android:name="com.example.poetry.WX_APP_ID"
            android:value="" />

        <activity
            android:name=".AuthorDetailActivity"
            android:exported="false"
            android:label="@string/author_detail_title"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.Poetry"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:label="@string/login_title"
            android:theme="@style/Theme.Poetry"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:label="@string/profile_title"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.Poetry"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".wxapi.WXEntryActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>

</manifest>
