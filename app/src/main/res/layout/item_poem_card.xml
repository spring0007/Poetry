<?xml version="1.0" encoding="utf-8"?>
<!-- 诗卡：左侧体裁色条 + 徽标 / 标题 / 作者 / 摘录 / 热度 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_3"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="@dimen/radius_lg"
    app:cardElevation="@dimen/elevation_card"
    app:strokeColor="?attr/colorOutline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:id="@+id/cardBar"
            android:layout_width="@dimen/size_card_bar"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="@dimen/space_4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/cardBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge"
                    android:paddingStart="@dimen/space_1"
                    android:paddingTop="1dp"
                    android:paddingEnd="@dimen/space_1"
                    android:paddingBottom="1dp"
                    android:textAppearance="@style/TextAppearance.Poetry.Caption"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/cardDynasty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_2"
                    android:textAppearance="@style/TextAppearance.Poetry.Caption" />
            </LinearLayout>

            <TextView
                android:id="@+id/cardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:textAppearance="@style/TextAppearance.Poetry.CardTitle" />

            <TextView
                android:id="@+id/cardAuthor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Poetry.Caption" />

            <TextView
                android:id="@+id/cardExcerpt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:lineSpacingExtra="@dimen/line_spacing_poem"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.Poetry.BodySmall" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/cardStars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Poetry.Caption"
                    android:textColor="@color/color_gold" />

                <TextView
                    android:id="@+id/cardHot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_3"
                    android:textAppearance="@style/TextAppearance.Poetry.CaptionWeak" />

                <TextView
                    android:id="@+id/cardFavFlag"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textAppearance="@style/TextAppearance.Poetry.CaptionWeak" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
