    <!-- 墨韵：素白纸 + 墨黑（极简） -->
    <style name="Theme.Poetry.Moyu" parent="Theme.Poetry">
        <item name="colorPrimary">@color/skin_moyu_primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/skin_moyu_accent</item>
        <item name="colorOnSecondary">@color/on_primary</item>
