<?xml version="1.0" encoding="utf-8"?>
<!--
    明文 HTTP 只对**回环地址**开口，为的是本地测试诗库下载。

    API 28 起系统默认禁止明文，而报错是 「Cleartext HTTP traffic not permitted」——
    发生在传输任何字节之前，只有真机能看出来（API 24~27 的设备又是好的，所以像偶发 bug）。
    模拟器访问宿主机上的测试服务器用 10.0.2.2，真机走 adb reverse 用 localhost。

    刻意**不用** android:usesCleartextTraffic="true"：那是给所有域名开口，
    生产环境的诗库地址会跟着降级成明文。这两个域名的共同点是**不可能**指向公网服务器，
    所以这份配置进了生产包也不会带来任何实际风险。
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- 真机经 Wi-Fi 直连开发机（无线调试下 adb reverse 会随会话断开，局域网更稳） -->
        <domain includeSubdomains="false">192.168.1.114</domain>
    </domain-config>
</network-security-config>
