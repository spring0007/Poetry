<?xml version="1.0" encoding="utf-8"?>
<!-- 发现页：Hero 今日推荐 + 体裁快捷筛选 + 精选诗词列表 + 空态 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/discoverScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clipToPadding="false"
    android:paddingStart="@dimen/page_margin"
    android:paddingTop="@dimen/space_2"
    android:paddingEnd="@dimen/page_margin"
    android:paddingBottom="@dimen/space_10">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 今日推荐 -->
        <include
            android:id="@+id/heroCard"
            layout="@layout/view_hero_card" />

        <!-- 热点诗词 -->
        <include
            android:id="@+id/hotHeader"
            layout="@layout/view_section_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_5" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/hotList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            android:visibility="gone" />

        <!-- 体裁快捷筛选 -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/kindChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_5"
            app:chipSpacingHorizontal="@dimen/space_2"
            app:singleLine="false" />

        <!-- 精选诗词 -->
        <include
            android:id="@+id/featuredHeader"
            layout="@layout/view_section_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/poemList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

        <ProgressBar
            android:id="@+id/loadingBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_8"
            android:visibility="gone" />

        <include
            android:id="@+id/emptyState"
            layout="@layout/view_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
