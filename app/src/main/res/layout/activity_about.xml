<?xml version="1.0" encoding="utf-8"?>
<!-- 关于页：版本 / 诗库 / 离线语音 / 隐私说明 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <!-- 工具条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_2"
        android:paddingTop="@dimen/space_2"
        android:paddingEnd="@dimen/space_2"
        android:paddingBottom="@dimen/space_2">

        <ImageButton
            android:id="@+id/backButton"
            style="@style/Widget.Poetry.IconButton"
            android:layout_width="@dimen/size_icon_button"
            android:layout_height="@dimen/size_icon_button"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/about_title"
            android:textAppearance="@style/TextAppearance.Poetry.SectionTitle" />

        <View
            android:layout_width="@dimen/size_icon_button"
            android:layout_height="@dimen/size_icon_button" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="@dimen/space_2"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="@dimen/space_10">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 品牌 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_lg"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/space_6">

                <TextView
                    android:id="@+id/aboutIcon"
                    android:layout_width="@dimen/size_avatar"
                    android:layout_height="@dimen/size_avatar"
                    android:background="@drawable/bg_circle"
                    android:gravity="center"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.Poetry.CardTitle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.Poetry.SectionTitle" />

                <TextView
                    android:id="@+id/aboutVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:textAppearance="@style/TextAppearance.Poetry.Caption" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="@string/about_slogan"
                    android:textAppearance="@style/TextAppearance.Poetry.CaptionWeak" />
            </LinearLayout>

            <!-- 诗库 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:background="@drawable/bg_card_lg"
                android:orientation="vertical"
                android:padding="@dimen/space_4">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_group_library"
                    android:textAppearance="@style/TextAppearance.Poetry.CardTitle" />

                <TextView
                    android:id="@+id/aboutSource"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:textAppearance="@style/TextAppearance.Poetry.Body" />

                <TextView
                    android:id="@+id/aboutApi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:textAppearance="@style/TextAppearance.Poetry.CaptionWeak" />

                <TextView
                    android:id="@+id/aboutLibraryNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="@string/about_library_note"
                    android:textAppearance="@style/TextAppearance.Poetry.CaptionWeak" />
            </LinearLayout>

            <!-- 离线语音 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:background="@drawable/bg_card_lg"
                android:orientation="vertical"
                android:padding="@dimen/space_4">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_group_voice"
                    android:textAppearance="@style/TextAppearance.Poetry.CardTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="@string/about_voice_engine"
                    android:textAppearance="@style/TextAppearance.Poetry.Body" />

                <TextView
                    android:id="@+id/aboutVoiceState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:textAppearance="@style/TextAppearance.Poetry.CaptionWeak" />
            </LinearLayout>

            <!-- 隐私 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:background="@drawable/bg_card_lg"
                android:orientation="vertical"
                android:padding="@dimen/space_4">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_group_privacy"
                    android:textAppearance="@style/TextAppearance.Poetry.CardTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="@string/about_privacy_body"
                    android:textAppearance="@style/TextAppearance.Poetry.Body" />
            </LinearLayout>

            <!-- 数据备份 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:background="@drawable/bg_card_lg"
                android:orientation="vertical"
                android:padding="@dimen/space_4">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_group_data"
                    android:textAppearance="@style/TextAppearance.Poetry.CardTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="@string/about_data_body"
                    android:textAppearance="@style/TextAppearance.Poetry.Body" />

                <TextView
                    android:id="@+id/aboutDataPath"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:textAppearance="@style/TextAppearance.Poetry.CaptionWeak" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/aboutExportData"
                        style="@style/Widget.Poetry.ToolButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_2"
                        android:layout_weight="1"
                        android:text="@string/about_export_data" />

                    <Button
                        android:id="@+id/aboutImportData"
                        style="@style/Widget.Poetry.ToolButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:layout_weight="1"
                        android:text="@string/about_import_data" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/aboutCheckUpdate"
                style="@style/Widget.Poetry.ToolButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/about_check_update" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:gravity="center"
                android:text="@string/about_footer"
                android:textAppearance="@style/TextAppearance.Poetry.CaptionWeak" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
