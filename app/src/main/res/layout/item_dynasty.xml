<?xml version="1.0" encoding="utf-8"?>
<!-- 朝代宫格 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dynastyRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_md"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_2"
    android:paddingTop="@dimen/space_3"
    android:paddingEnd="@dimen/space_2"
    android:paddingBottom="@dimen/space_3">

    <TextView
        android:id="@+id/dynastyName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Poetry.CardTitle"
        android:textSize="@dimen/text_lg" />

    <TextView
        android:id="@+id/dynastyCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_1"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Poetry.CaptionWeak" />

</LinearLayout>
