<?xml version="1.0" encoding="utf-8"?>
<!-- 热点榜条目：排名徽标 + 标题 + 作者 · 热度 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hotRoot"
    android:layout_width="@dimen/size_hot_card"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/space_3"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_3">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hotRank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:includeFontPadding="false"
                android:paddingStart="@dimen/space_2"
                android:paddingTop="1dp"
                android:paddingEnd="@dimen/space_2"
                android:paddingBottom="1dp"
                android:textAppearance="@style/TextAppearance.Poetry.Caption"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/hotBadge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Poetry.CaptionWeak" />
        </LinearLayout>

        <TextView
            android:id="@+id/hotTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Poetry.CardTitle"
            android:textSize="@dimen/text_base" />

        <TextView
            android:id="@+id/hotAuthor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Poetry.Caption" />

        <TextView
            android:id="@+id/hotValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:textAppearance="@style/TextAppearance.Poetry.CaptionWeak" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
