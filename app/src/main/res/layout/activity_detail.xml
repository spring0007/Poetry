<?xml version="1.0" encoding="utf-8"?>
<!--
  作品详情：顶部标题栏（滚动时显现标题）+ 正文（横排/竖排，可注音）+ 译文/注释/赏析 + 底部朗读条
  竖屏下正文与标题一律居中排版。
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- 顶部标题栏 -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:liftOnScroll="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:menu="@menu/menu_detail"
            app:navigationContentDescription="@string/cd_back"
            app:navigationIcon="@drawable/ic_back"
            app:titleCentered="true" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/detailScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="@dimen/page_margin"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="@dimen/space_6"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 标题 -->
            <TextView
                android:id="@+id/poemTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_2"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textAppearance="@style/TextAppearance.Poetry.PageTitle" />

            <!-- 徽标 + 作者 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_3"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/poemBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge"
                    android:includeFontPadding="false"
                    android:paddingStart="@dimen/space_2"
                    android:paddingTop="2dp"
                    android:paddingEnd="@dimen/space_2"
                    android:paddingBottom="2dp"
                    android:textAppearance="@style/TextAppearance.Poetry.Caption"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/poemAuthor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_2"
                    android:includeFontPadding="false"
                    android:textAppearance="@style/TextAppearance.Poetry.Caption" />
            </LinearLayout>

            <TextView
                android:id="@+id/poemMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_1"
                android:includeFontPadding="false"
                android:textAppearance="@style/TextAppearance.Poetry.CaptionWeak" />

            <!-- 平仄（可选库可用时展示） -->
            <LinearLayout
                android:id="@+id/strainRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_3"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/detail_strain"
                    android:textAppearance="@style/TextAppearance.Poetry.Caption"
                    android:textColor="@color/ink_400" />

                <TextView
                    android:id="@+id/strainText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_2"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:textAppearance="@style/TextAppearance.Poetry.Caption" />
            </LinearLayout>

            <!-- 正文：横排（无注音） -->
            <TextView
                android:id="@+id/poemBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textAppearance="@style/TextAppearance.Poetry.Poem" />

            <!-- 正文：带拼音注音（横排 / 竖排都用它；竖排列数多时可横向滚动） -->
            <HorizontalScrollView
                android:id="@+id/pinyinScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5"
                android:fillViewport="true"
                android:scrollbars="none"
                android:visibility="gone">

                <com.example.poetry.ui.PinyinView
                    android:id="@+id/pinyinBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </HorizontalScrollView>

            <!-- 正文：竖排（按句分列，自右向左） -->
            <HorizontalScrollView
                android:id="@+id/verticalScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5"
                android:fillViewport="false"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/verticalContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- 工具按钮 -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/toolVertical"
                        style="@style/Widget.Poetry.ToolButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:text="@string/tool_vertical" />

                    <Button
                        android:id="@+id/toolFontSmaller"
                        style="@style/Widget.Poetry.ToolButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:minWidth="0dp"
                        android:text="@string/tool_font_smaller" />

                    <Button
                        android:id="@+id/toolFontLarger"
                        style="@style/Widget.Poetry.ToolButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:minWidth="0dp"
                        android:text="@string/tool_font_larger" />

                    <Button
                        android:id="@+id/toolFontFamily"
                        style="@style/Widget.Poetry.ToolButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:minWidth="0dp"
                        android:text="@string/tool_font_family" />

                    <Button
                        android:id="@+id/toolNote"
                        style="@style/Widget.Poetry.ToolButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:minWidth="0dp"
                        android:text="@string/tool_note" />

                    <Button
                        android:id="@+id/toolPinyin"
                        style="@style/Widget.Poetry.ToolButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:minWidth="0dp"
                        android:text="@string/tool_pinyin" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- 译文 / 注释 / 赏析 -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/contentTabs"
                style="@style/Widget.Poetry.TabLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6" />

            <TextView
                android:id="@+id/contentText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:lineSpacingExtra="@dimen/line_spacing_body"
                android:textAppearance="@style/TextAppearance.Poetry.Body" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 底部朗读条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="?attr/colorSurface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_4"
        android:paddingTop="@dimen/space_2"
        android:paddingEnd="@dimen/space_4"
        android:paddingBottom="@dimen/space_3">

        <ImageButton
            android:id="@+id/playButton"
            android:layout_width="@dimen/size_play_button"
            android:layout_height="@dimen/size_play_button"
            android:background="@drawable/bg_play_button"
            android:contentDescription="@string/cd_play"
            android:src="@drawable/ic_play"
            app:tint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_3"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nowPlaying"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Poetry.BodySmall" />

            <ProgressBar
                android:id="@+id/playProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_progress_height"
                android:layout_marginTop="@dimen/space_2"
                android:max="100"
                android:progressDrawable="@drawable/bg_progress" />

            <TextView
                android:id="@+id/voiceLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:textAppearance="@style/TextAppearance.Poetry.CaptionWeak" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/voiceButton"
            android:layout_width="@dimen/size_icon_button"
            android:layout_height="@dimen/size_icon_button"
            android:layout_marginStart="@dimen/space_2"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/cd_voice"
            android:src="@drawable/ic_volume"
            app:tint="@color/ink_700" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
