<?xml version="1.0" encoding="utf-8"?>
<!-- 书架行卡：体裁色条 + 标题 + 元信息 + 移出 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_2"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_3">

        <View
            android:id="@+id/rowBar"
            android:layout_width="3dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_progress_track" />

        <LinearLayout
            android:id="@+id/rowContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_3"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/rowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Poetry.CardTitle"
                android:textSize="@dimen/text_base" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/rowBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge"
                    android:paddingStart="@dimen/space_1"
                    android:paddingTop="1dp"
                    android:paddingEnd="@dimen/space_1"
                    android:paddingBottom="1dp"
                    android:textAppearance="@style/TextAppearance.Poetry.Caption"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/rowMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_2"
                    android:textAppearance="@style/TextAppearance.Poetry.Caption" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/rowRemove"
            android:layout_width="@dimen/size_row_icon"
            android:layout_height="@dimen/size_row_icon"
            android:background="@drawable/bg_circle"
            android:contentDescription="@string/cd_remove"
            android:src="@drawable/ic_close"
            android:visibility="gone"
            app:tint="@color/ink_400" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
