<?xml version="1.0" encoding="utf-8"?>
<!--
    明文 HTTP 只对**逐个列出的主机**开口，不整体放开。

    API 28 起系统默认禁止明文，而报错是 「Cleartext HTTP traffic not permitted」——
    发生在传输任何字节之前，只有真机能看出来（API 24~27 的设备又是好的，所以像偶发 bug）。
    模拟器访问宿主机上的测试服务器用 10.0.2.2，真机走 adb reverse 用 localhost。

    刻意**不用** android:usesCleartextTraffic="true"：那是给所有域名开口，
    以后任何一处地址被改成 http 都会静默生效、没人拦。列在下面的每一条都要单独说明用途。

    === 2026-10-10 变更 ===
    云端 ECS 已上 HTTPS：Nginx 在 443 终止 TLS，反代到只绑定回环的 poetry-server。
    证书是**自签 CA**（非公信 CA），所以这里做了两件事：
      1. 删掉 47.106.68.18 的明文口 —— 该地址已不再监听明文 8000；
      2. 针对该 IP 追加自签根证书作为信任锚。
    注意 <trust-anchors> 里写了 src="system"，是「在系统信任库之外**多加**一个锚」，
    而不是替换 —— 否则 App 里其他 HTTPS 调用（分享、统计等）会一并失败。
    自签根证书 10 年有效（至 2036-10），无续期维护成本。
-->
<network-security-config>
    <!-- 仅本地联调保留明文：模拟器宿主机 / adb reverse -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>

    <!-- 云端后端：HTTPS + 自签 CA（system 与自签并列，二者都受信任） -->
    <domain-config>
        <domain includeSubdomains="false">47.106.68.18</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/poetry_ca" />
        </trust-anchors>
    </domain-config>
</network-security-config>
