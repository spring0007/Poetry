<?xml version="1.0" encoding="utf-8"?>
<!-- 数据统计页：按日期查看朗读了哪些诗、收藏了哪些诗 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <!-- 工具条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_2"
        android:paddingTop="@dimen/space_2"
        android:paddingEnd="@dimen/space_2"
        android:paddingBottom="@dimen/space_2">

        <ImageButton
            android:id="@+id/backButton"
            style="@style/Widget.Poetry.IconButton"
            android:layout_width="@dimen/size_icon_button"
            android:layout_height="@dimen/size_icon_button"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/stats_title"
            android:textAppearance="@style/TextAppearance.Poetry.SectionTitle" />

        <View
            android:layout_width="@dimen/size_icon_button"
            android:layout_height="@dimen/size_icon_button" />
    </LinearLayout>

    <TextView
        android:id="@+id/statsSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="@dimen/space_1"
        android:paddingEnd="@dimen/page_margin"
        android:textAppearance="@style/TextAppearance.Poetry.CaptionWeak" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="@dimen/space_3"
        android:paddingEnd="@dimen/page_margin">

        <LinearLayout
            android:id="@+id/statsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_6" />
    </ScrollView>

    <include
        android:id="@+id/emptyState"
        layout="@layout/view_empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="@dimen/page_margin"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="@dimen/space_4"
        android:text="@string/stats_file_hint"
        android:textAppearance="@style/TextAppearance.Poetry.CaptionWeak" />

</LinearLayout>
