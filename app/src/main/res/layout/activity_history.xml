<?xml version="1.0" encoding="utf-8"?>
<!-- 朗读历史页：最近读过的作品，可单条删除或一键清空 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <!-- 工具条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_2"
        android:paddingTop="@dimen/space_2"
        android:paddingEnd="@dimen/space_2"
        android:paddingBottom="@dimen/space_2">

        <ImageButton
            android:id="@+id/backButton"
            style="@style/Widget.Poetry.IconButton"
            android:layout_width="@dimen/size_icon_button"
            android:layout_height="@dimen/size_icon_button"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/history_title"
            android:textAppearance="@style/TextAppearance.Poetry.SectionTitle" />

        <TextView
            android:id="@+id/clearButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/space_2"
            android:paddingEnd="@dimen/space_2"
            android:text="@string/history_clear"
            android:textAppearance="@style/TextAppearance.Poetry.Caption" />
    </LinearLayout>

    <TextView
        android:id="@+id/historySummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="@dimen/space_1"
        android:paddingEnd="@dimen/page_margin"
        android:textAppearance="@style/TextAppearance.Poetry.CaptionWeak" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/historyList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_2"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/page_margin"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="@dimen/space_10" />

    <include
        android:id="@+id/emptyState"
        layout="@layout/view_empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
