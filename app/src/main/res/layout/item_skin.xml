<?xml version="1.0" encoding="utf-8"?>
<!-- 皮肤卡片：底色即该皮肤的纸色，圆点为主色 / 强调色，右下角标注是否正在使用 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/skinCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/dotPrimary"
            android:layout_width="@dimen/size_checkin_dot"
            android:layout_height="@dimen/size_checkin_dot"
            android:background="@drawable/bg_circle" />

        <View
            android:id="@+id/dotAccent"
            android:layout_width="@dimen/size_checkin_dot"
            android:layout_height="@dimen/size_checkin_dot"
            android:layout_marginStart="@dimen/space_2"
            android:background="@drawable/bg_circle" />

        <TextView
            android:id="@+id/skinTag"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textAppearance="@style/TextAppearance.Poetry.Caption" />
    </LinearLayout>

    <TextView
        android:id="@+id/skinName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:textAppearance="@style/TextAppearance.Poetry.CardTitle" />

    <TextView
        android:id="@+id/skinDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_1"
        android:textAppearance="@style/TextAppearance.Poetry.CaptionWeak" />
</LinearLayout>
